final internal class StreamDecryptor : FeasyMeshSDK.Cryptor, FeasyMeshSDK.Updatable {
  @usableFromInline
  final internal let blockSize: Swift.Int
  @usableFromInline
  final internal var worker: any FeasyMeshSDK.CipherModeWorker
  @usableFromInline
  final internal let padding: FeasyMeshSDK.Padding
  @usableFromInline
  final internal var accumulated: [Swift.UInt8]
  @usableFromInline
  final internal var lastBlockRemainder: Swift.Int
  @usableFromInline
  internal init(blockSize: Swift.Int, padding: FeasyMeshSDK.Padding, _ worker: any FeasyMeshSDK.CipherModeWorker) throws
  @inlinable final public func update(withBytes bytes: Swift.ArraySlice<Swift.UInt8>, isLast: Swift.Bool) throws -> Swift.Array<Swift.UInt8> {
